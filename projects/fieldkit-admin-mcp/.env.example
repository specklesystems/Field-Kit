# fieldkit-admin-mcp — FieldKit's local Speckle admin and data companion
# Copy this file to .env and fill in your values. Local/stdio use only.

# Base URL of the Speckle Server you're administering (no trailing slash).
# e.g. https://app.speckle.systems or your self-hosted instance.
SPECKLE_SERVER_URL=https://app.speckle.systems

# Personal Access Token from that server: Profile → Settings → Developer settings
# → Personal access tokens → New token. Needs at least these scopes for the
# tools below to work: profile:read, users:read, users:invite, server:setup.
# (server:setup gates the AdminQueries/AdminMutations surface server-side —
# without it, admin tools will fail with a permission error even with a valid token.)
# Add streams:write too if you want create_support_project / upload_file_to_project.
SPECKLE_TOKEN=your-personal-access-token-here

# Set to "true" to allow the mutation tools (update_user_role, delete_user,
# update_email_verification, update_server_info, create_server_invite,
# create_support_project, upload_file_to_project).
# Leave unset/false to run in read-only mode.
SPECKLE_ADMIN_ALLOW_WRITES=false
