# FieldKit-managed child repositories
/projects/*
!/projects/README.md
!/projects/fieldkit-admin-mcp/
!/projects/fieldkit-admin-mcp/**

# Personal material stays on this machine
/personal/*
!/personal/README.md

# Organisation and project practice packs are independent, often private repos
/practice-packs/*
!/practice-packs/README.md

# Local configuration and common generated files
.env
.env.*
!.env.example
mise.local.toml
mise.*.local.toml

# Analysis extracts and generated evidence can contain customer model data.
/analyses/*/data/
/analyses/*/outputs/
.DS_Store
__pycache__/
*.pyc

